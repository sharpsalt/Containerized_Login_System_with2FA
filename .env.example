# Environment configuration for Auth CLI
# Copy this file to .env and modify as needed.
# Docker Compose will automatically read .env files.

# ── Database Settings ────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=authuser
DB_PASSWORD=authpass
DB_NAME=authdb
DB_SSLMODE=disable

# ── Security Settings ───────────────────────────────────────
# Session timeout in minutes (default: 30)
SESSION_TIMEOUT_MINUTES=30

# Maximum failed login attempts before account lockout (default: 5)
MAX_FAILED_ATTEMPTS=5

# Account lockout duration in minutes (default: 15)
LOCKOUT_DURATION_MINUTES=15

# bcrypt hash cost factor, 10-16 (default: 12, higher = slower + more secure)
BCRYPT_COST=12

# ── Password Policy ─────────────────────────────────────────
# Minimum password length (default: 8, minimum: 8)
MIN_PASSWORD_LENGTH=8

# Maximum password length (default: 72, bcrypt limit)
MAX_PASSWORD_LENGTH=72

# Require at least one uppercase letter (default: true)
REQUIRE_UPPERCASE=true

# Require at least one lowercase letter (default: true)
REQUIRE_LOWERCASE=true

# Require at least one digit (default: true)
REQUIRE_DIGIT=true

# Require at least one special character (default: false)
REQUIRE_SPECIAL=false

# ── TOTP Encryption ─────────────────────────────────────────
# Key used to encrypt TOTP secrets at rest (AES-256-GCM)
#   CHANGE THIS IN PRODUCTION! Must be at least 16 characters.
TOTP_ENCRYPTION_KEY=change-me-in-production-32bytes!
